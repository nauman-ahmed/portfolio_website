# Copy to .env for local development. Never commit .env.
# In production these are set in Vercel: Settings -> Environment Variables.

# Gmail App Password (NOT your account password)
# https://myaccount.google.com/apppasswords
EMAIL_USER=your-address@gmail.com
EMAIL_PASS=your-16-char-app-password

# Optional. Where enquiries are delivered. Defaults to EMAIL_USER, plus-addressed
# for Gmail (you+portfolio@gmail.com) so a filter can label them automatically.
# EMAIL_TO=you+portfolio@gmail.com
