# Copy to .env and fill in real values. Never commit .env.
# Gmail App Password (NOT your account password) — https://myaccount.google.com/apppasswords
EMAIL_USER=your-address@gmail.com
EMAIL_PASS=your-16-char-app-password

# Comma-separated origins allowed to call the API.
ALLOWED_ORIGINS=https://your-site.vercel.app,http://localhost:5173

# Optional; defaults to 5001.
PORT=5001
